# Go
/go/
*.exe
*.test
*.out

# Build outputs (root-level only; internal/webui/dist is handled below)
/bin/
/build/
/dist/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Data (runtime)
data/

# Plugins (loaded at runtime)
plugins/go/*.so

# Web dependencies and the built editor (embedded into the binary from
# internal/webui/dist; only the placeholder is tracked)
web/node_modules/
web/dist/
web/.cache/
internal/webui/dist/*
!internal/webui/dist/.gitkeep

# Environment
.env
.env.local
.env.*.local

# Dependency directories
vendor/

# Go workspace file
.go.work
.go.work.sum

# Local build artifacts (never commit the server binary)
/go-red
/tmp/
